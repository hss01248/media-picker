<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="picker-camera-wrapper 测试"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_wrapper_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="底部弹窗：拍照 / 拍视频 / 相册" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="android-photo-picker 测试"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_pick_uri_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="单选图片 → 返回 Uri（默认）" />

        <Button
            android:id="@+id/btn_pick_uri_multi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="多选图+视频 → 返回 Uri" />

        <Button
            android:id="@+id/btn_pick_copy_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="单选图片 → copyToPath(true)" />

        <Button
            android:id="@+id/btn_pick_copy_multi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="多选+限制 → copyToPath(true)" />

        <Button
            android:id="@+id/btn_filter_partial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="过滤自测：部分不合格" />

        <Button
            android:id="@+id/btn_filter_all_reject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="过滤自测：全部不合格" />

        <Button
            android:id="@+id/btn_filter_all_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="过滤自测：全部合格（无弹窗）" />

        <Button
            android:id="@+id/btn_pick_single_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="单选视频 → Uri" />

        <Button
            android:id="@+id/btn_manual_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用 MediaCopyUtil 拷贝上次 Uri" />

        <Button
            android:id="@+id/btn_delete_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="删除上次本地路径" />

        <Button
            android:id="@+id/btn_clear_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空全部拷贝文件" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="结果会显示在这里"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
